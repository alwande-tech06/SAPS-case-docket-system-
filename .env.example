# Copy to .env and fill in. .env is git-ignored.

# postgresql://<user>:<password>@<host>:<port>/<database>
# Write any @ or % in the password as %40 or %25.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/saps_docket

# A long random string (at least 32 characters in production), e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# development (local, debug on) or production (behind HTTPS)
FLASK_CONFIG=development

# Adds a "Reset demonstration data" button to the sign-in page, which wipes
# the database and reloads the demo data. Off unless set. Never on a system
# the public uses.
# DEMO_MODE=true

# How one-time codes reach a phone: demo (shown on screen), console (written to
# the server log), or a real gateway wired into app/services/otp.py.
# SMS_PROVIDER=demo

# Hours a staff sign-in lasts before signing in again.
# SESSION_HOURS=8

# Password-reset emails: demo (link shown on screen), console (server log) or smtp.
# Defaults to demo in development and console in production.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587                  # 587 with STARTTLS, or 465 for SSL
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=SAPS Dockets <noreply@example.org>
# The address staff use to reach the site, for the links in emails.
# PUBLIC_BASE_URL=https://dockets.example.org

# Escalate reports undisposed for 24 hours from inside the application.
# Alternatively schedule `flask escalate-overdue` with cron / Task Scheduler.
# SCHEDULER_ENABLED=true
# ESCALATION_INTERVAL_MINUTES=15
